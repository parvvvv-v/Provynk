rules_version = '2';

service cloud.firestore {
  match /databases/{db}/documents {

    // True only after the user has clicked the link in the verification email
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Founder (read-only access to everything, for the Founder dashboard). Must be a verified email.
    function founder() {
      return verified() && request.auth.token.email.lower() == 'contactprovynk@gmail.com';
    }

    // Profiles, company details, shortlist (all stored on the user doc)
    match /users/{u} {
      // Unverified users can only read their own profile
      allow read: if request.auth != null
                  && (verified() || request.auth.uid == u);

      allow read: if founder();

      // Public: individual (candidate) profiles can be listed on the landing page without login
      allow read: if resource.data.type == 'candidate';

      // Three account types: candidate (individual), org (employer), group (consultancy / group)
      allow create: if verified()
                    && request.auth.uid == u
                    && request.resource.data.type in ['candidate', 'org', 'group'];

      // Owner can edit (after verifying email), but cannot switch account type.
      // Employers can no longer create pods / rosters.
      allow update: if verified()
                    && request.auth.uid == u
                    && request.resource.data.type == resource.data.type
                    && !(resource.data.type == 'org'
                         && request.resource.data.diff(resource.data).affectedKeys().hasAny(['roster', 'podList', 'pods']));

      allow delete: if false;
    }

    // Profile background photos have been removed from the site (profile photo lives on the user doc),
    // so the "photos" collection is no longer readable or writable.

    // Consultancy / group accounts: members share a shortlist and notes
    match /groups/{g} {
      allow read: if founder();
      allow read: if verified()
                  && (resource.data.ownerId == request.auth.uid
                      || request.auth.token.email.lower() in resource.data.memberEmails);

      allow create: if verified()
                    && request.resource.data.ownerId == request.auth.uid
                    && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.type == 'group';

      // Owner can edit everything (members, name); members may only change shortlist and notes
      allow update: if verified()
                    && ((resource.data.ownerId == request.auth.uid
                         && request.resource.data.ownerId == resource.data.ownerId
                         // Owner can remove members but not add them directly (people join by accepting an invitation)
                         && request.resource.data.memberEmails.toSet().difference(resource.data.memberEmails.toSet()).size() == 0)
                        || (request.auth.token.email.lower() in resource.data.memberEmails
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saved', 'comments']))
                        // An invited person can add only their own email, and only with a pending invitation
                        || (!(request.auth.token.email.lower() in resource.data.memberEmails)
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberEmails'])
                            && request.resource.data.memberEmails == resource.data.memberEmails.concat([request.auth.token.email.lower()])
                            && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.type != 'org'
                            && get(/databases/$(db)/documents/invites/$(g + '_' + request.auth.token.email.lower())).data.status == 'pending'));

      allow delete: if verified() && resource.data.ownerId == request.auth.uid;
    }

    // Public group showcase (owner details + members without e-mail), readable by everyone, written only by the group owner
    match /publicGroups/{g} {
      allow read: if true;
      allow create: if verified() && request.resource.data.ownerId == request.auth.uid;
      allow update: if verified() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if verified() && resource.data.ownerId == request.auth.uid;
    }

    // Group invitations: owner invites by email, invitee accepts or declines
    match /invites/{i} {
      allow read: if founder();
      allow read: if verified()
                  && (resource.data.invitedBy == request.auth.uid
                      || resource.data.inviteeEmail == request.auth.token.email.lower());

      allow create: if verified()
                    && request.resource.data.invitedBy == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && i == request.resource.data.groupId + '_' + request.resource.data.inviteeEmail
                    && get(/databases/$(db)/documents/groups/$(request.resource.data.groupId)).data.ownerId == request.auth.uid;

      allow update: if verified()
                    && ((resource.data.invitedBy == request.auth.uid
                         && request.resource.data.invitedBy == request.auth.uid
                         && request.resource.data.groupId == resource.data.groupId
                         && request.resource.data.inviteeEmail == resource.data.inviteeEmail)
                        || (resource.data.inviteeEmail == request.auth.token.email.lower()
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                            && request.resource.data.status in ['accepted', 'declined']
                            && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.type != 'org'));

      allow delete: if verified() && resource.data.invitedBy == request.auth.uid;
    }

    // Outgoing invitation emails (Firebase "Trigger Email" extension reads this collection)
    match /mail/{m} {
      allow read: if false;
      allow create: if verified()
                    && request.resource.data.keys().hasOnly(['to', 'replyTo', 'message'])
                    && request.resource.data.to.size() == 1
                    && request.resource.data.replyTo == request.auth.token.email.lower()
                    && request.resource.data.message.keys().hasOnly(['subject', 'text', 'html']);
      allow update, delete: if false;
    }

    // CVs of members typed in by a group owner (never public): the owner writes and deletes;
    // the group owner and registered group mates can read. Doc id = groupId_memberId.
    match /groupCVs/{c} {
      allow read: if founder();
      allow read: if verified()
                  && (get(/databases/$(db)/documents/groups/$(resource.data.groupId)).data.ownerId == request.auth.uid
                      || request.auth.token.email.lower() in get(/databases/$(db)/documents/groups/$(resource.data.groupId)).data.memberEmails);
      allow create, update: if verified()
                            && c == request.resource.data.groupId + '_' + request.resource.data.memberId
                            && get(/databases/$(db)/documents/groups/$(request.resource.data.groupId)).data.ownerId == request.auth.uid;
      allow delete: if verified()
                    && get(/databases/$(db)/documents/groups/$(resource.data.groupId)).data.ownerId == request.auth.uid;
    }

    // CV files: owner writes; employers, groups and the person's group mates can read
    function myType() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.type; }
    function mateAt(r, i) {
      return r.data.groupIds.size() > i
             && request.auth.token.email.lower() in get(/databases/$(db)/documents/groups/$(r.data.groupIds[i])).data.memberEmails;
    }
    match /resumes/{u} {
      allow read: if founder();
      allow read: if verified()
                  && (request.auth.uid == u
                      || myType() in ['org', 'group']
                      || (resource.data.groupIds is list
                          && (mateAt(resource, 0) || mateAt(resource, 1) || mateAt(resource, 2) || mateAt(resource, 3) || mateAt(resource, 4))));
      allow create, update: if verified() && request.auth.uid == u;
      allow delete: if false;
    }

    // Job posts: public to read, only the owning (verified) employer can write
    match /jobs/{j} {
      allow read: if true;

      allow create: if verified()
                    && request.resource.data.orgId == request.auth.uid;

      allow update: if verified()
                    && resource.data.orgId == request.auth.uid
                    && request.resource.data.orgId == resource.data.orgId;

      allow delete: if verified() && resource.data.orgId == request.auth.uid;
    }

    // "Find Solutions" enquiries: anyone (even logged out) can leave one, nobody can read them in the app.
    // Read them in Firebase Console > Firestore > solutionRequests (or e-mail, if FormSubmit is set up).
    match /solutionRequests/{r} {
      allow create: if request.resource.data.keys().hasAll(['type', 'name', 'email', 'message', 'created'])
                    && request.resource.data.keys().hasOnly(['type', 'name', 'email', 'phone', 'firm', 'message', 'details', 'attachmentName', 'attachmentType', 'attachmentChunks', 'uid', 'created'])
                    && request.resource.data.type in ['candidate', 'org', 'group']
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.email.matches('.+@.+[.].+')
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000
                    && request.resource.data.created == request.time
                    && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 40))
                    && (!('firm' in request.resource.data) || (request.resource.data.firm is string && request.resource.data.firm.size() <= 120))
                    && (!('attachmentName' in request.resource.data) || (request.resource.data.attachmentName is string && request.resource.data.attachmentName.size() <= 200))
                    && (!('attachmentType' in request.resource.data) || (request.resource.data.attachmentType is string && request.resource.data.attachmentType.size() <= 100))
                    && (!('attachmentChunks' in request.resource.data) || (request.resource.data.attachmentChunks is int && request.resource.data.attachmentChunks >= 1 && request.resource.data.attachmentChunks <= 12))
                    && (!('details' in request.resource.data) || (request.resource.data.details is map && request.resource.data.details.size() <= 20))
                    && (!('uid' in request.resource.data) || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read: if founder();
      allow update, delete: if false;

      // Uploaded attachment, stored in pieces (base64) so the founder can download it
      match /files/{c} {
        allow create: if c.matches('[0-9]+')
                      && request.resource.data.keys().hasOnly(['i', 'data'])
                      && request.resource.data.i is int
                      && request.resource.data.i == int(c)
                      && request.resource.data.data is string
                      && request.resource.data.data.size() <= 700000
                      && int(c) < get(/databases/$(db)/documents/solutionRequests/$(r)).data.attachmentChunks;
        allow read: if founder();
        allow update, delete: if false;
      }
    }

    // Visitor analytics: anyone (even logged out) can record a page view and later update its time-on-page;
    // only the founder can read them (Founder dashboard > Visitors).
    match /pageViews/{p} {
      allow create: if request.resource.data.keys().hasAll(['sid', 'vid', 'page', 'start', 'dur'])
                    && request.resource.data.keys().hasOnly(['sid', 'vid', 'page', 'start', 'dur', 'uid'])
                    && request.resource.data.sid is string && request.resource.data.sid.size() <= 60
                    && request.resource.data.vid is string && request.resource.data.vid.size() <= 60
                    && request.resource.data.page is string && request.resource.data.page.size() <= 80
                    && request.resource.data.start == request.time
                    && request.resource.data.dur is number && request.resource.data.dur >= 0 && request.resource.data.dur <= 14400
                    && (!('uid' in request.resource.data) || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dur'])
                    && request.resource.data.dur is number && request.resource.data.dur >= 0 && request.resource.data.dur <= 14400;
      allow read: if founder();
      allow delete: if false;
    }

    // Applications
    match /applications/{a} {
      allow read: if founder();
      allow read: if request.auth != null
                  && (resource.data.candidateId == request.auth.uid
                      || resource.data.orgId == request.auth.uid);

      allow create: if verified()
                    && request.resource.data.candidateId == request.auth.uid
                    && request.resource.data.status == 'Applied'
                    && request.resource.data.orgId ==
                       get(/databases/$(db)/documents/jobs/$(request.resource.data.jobId)).data.orgId;

      allow update: if verified()
                    && resource.data.orgId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
  }
}
